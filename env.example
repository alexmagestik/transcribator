# Папки (относительно корня проекта, если путь не абсолютный)
SOURCE_DIR=source-mp3
RAW_DIR=raw
CLEAN_DIR=clean
NOTES_DIR=notes
SUMMARY_DIR=summary
PROMPTS_FILE=prompts.toml
STATUS_FILE=.transcribe-status.json

# Ollama
OLLAMA_HOST=http://127.0.0.1:11434

# Модели Ollama для каждого шага (можно переопределить через --ollama-* флаги)
# OLLAMA_MODEL — fallback если OLLAMA_CLEAN_MODEL / OLLAMA_SUMMARY_MODEL / OLLAMA_NOTES_MODEL не заданы
OLLAMA_MODEL=qwen3:4b-summary-32k
OLLAMA_CLEAN_MODEL=llama3.1-clean-32k:latest
OLLAMA_SUMMARY_MODEL=gemma4:e2b-32k
OLLAMA_NOTES_MODEL=gemma4:e2b-32k

OLLAMA_CHUNK_CHARS=24000
OLLAMA_TEMPERATURE_CLEAN=0.1
OLLAMA_TEMPERATURE_SUMMARY=0.4
OLLAMA_TEMPERATURE_NOTES=0.4

# Whisper: hotwords в prompts.toml, не initial_prompt (ломает начало записи)
WHISPER_MODEL=large-v3
# WHISPER_MODEL_PATH — локальный путь к модели (если задан, отключает запросы к HF)
# WHISPER_MODEL_PATH=/path/to/model
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5
WHISPER_LANGUAGE=ru
# none — не пропускать «тихие» 30-секундные чанки (рекомендуется для лекций)
WHISPER_NO_SPEECH_THRESHOLD=none
WHISPER_VAD_FILTER=false
WHISPER_CONDITION_ON_PREVIOUS_TEXT=true
